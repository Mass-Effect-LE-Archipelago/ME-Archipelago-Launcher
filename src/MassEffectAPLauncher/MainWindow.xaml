<Window x:Class="APSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:APSetup"
        Title="Mass Effect Archipelago Launcher" Width="1200" Height="780" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#03060C" Foreground="{StaticResource Text}" FontFamily="{StaticResource Body}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- background: deep space, a nebula glow in the game's colour, stars, hex grid, scanlines and a slow sweep -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#03060C" Offset="0" />
                    <GradientStop Color="#081224" Offset="0.6" />
                    <GradientStop Color="#03060C" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Ellipse x:Name="Nebula" Width="1100" Height="800" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-300,0" Opacity="0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="NebulaStop" Color="#55FF9F1C" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <local:Starfield x:Name="Stars" />
        <Rectangle x:Name="Hex" Opacity="0.07" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <RadialGradientBrush Center="0.75,0.2" GradientOrigin="0.75,0.2" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="#66000000">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <local:Emblem Width="24" Height="24" Brush="{DynamicResource Accent}" Effect="{DynamicResource GlowSoft}" />
                    <TextBlock Text="MASS EFFECT" Margin="12,0,0,0" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center" Foreground="{StaticResource Text}" />
                    <TextBlock Text="ARCHIPELAGO" Margin="7,0,0,0" FontFamily="{StaticResource Display}" FontWeight="Light" FontSize="15"
                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}" />
                    <TextBlock x:Name="VersionText" Margin="12,2,0,0" FontFamily="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LauncherUpdate" Style="{StaticResource Holo}" Visibility="Collapsed" Margin="0,7,12,7" Padding="12,3"
                            WindowChrome.IsHitTestVisibleInChrome="True" FontSize="12" />
                    <Button x:Name="MusicButton" Style="{StaticResource Caption}" Content="&#xE8D6;" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Background music (pick a file under Folders)" />
                    <Button x:Name="MinButton" Style="{StaticResource Caption}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaxButton" Style="{StaticResource Caption}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseButton" Style="{StaticResource Caption}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Accent}" Opacity="0.35" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- campaign rail -->
                <DockPanel Grid.Column="0" Margin="18,20,8,18">
                    <TextBlock DockPanel.Dock="Top" Text="SELECT CAMPAIGN" Style="{StaticResource Label}" Margin="4,0,0,12" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,12,0,0">
                        <TextBlock Text="LINKS" Style="{StaticResource Label}" Margin="0,0,0,8" />
                        <StackPanel x:Name="Links" />
                    </StackPanel>
                    <StackPanel x:Name="GameCards" />
                </DockPanel>

                <!-- main -->
                <Grid Grid.Column="1" Margin="12,14,22,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="GameKicker" Style="{StaticResource Label}" Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="GameTitle" FontFamily="{StaticResource Display}" FontSize="40" FontWeight="Bold" Margin="0,0,0,0"
                                   Foreground="{StaticResource Text}" Effect="{DynamicResource GlowSoft}" />
                        <TextBlock x:Name="GameTagline" FontSize="14" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12">
                        <RadioButton x:Name="TabDeploy" Style="{StaticResource NavTab}" Content="DEPLOY" GroupName="Nav" IsChecked="True" />
                        <RadioButton x:Name="TabFolders" Style="{StaticResource NavTab}" Content="FOLDERS" GroupName="Nav" />
                        <RadioButton x:Name="TabOptions" Style="{StaticResource NavTab}" Content="OPTIONS" GroupName="Nav" />
                        <RadioButton x:Name="TabIntel" Style="{StaticResource NavTab}" Content="INTEL" GroupName="Nav" />
                    </StackPanel>
                    <ContentControl x:Name="Page" Grid.Row="2" Focusable="False">
                        <ContentControl.RenderTransform>
                            <TranslateTransform />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Grid>

            <!-- footer -->
            <Grid Grid.Row="2" Background="#66000000">
                <TextBlock x:Name="Footer" Margin="16,0" VerticalAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="11"
                           Foreground="{StaticResource TextDim}" />
                <TextBlock Margin="16,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextDim}"
                           Text="Unofficial fan project. Not affiliated with BioWare or Electronic Arts." />
            </Grid>
        </Grid>

        <!-- scanlines and the sweep sit over everything but take no clicks -->
        <Rectangle x:Name="Scan" IsHitTestVisible="False" Opacity="0.35" />
        <Rectangle x:Name="Sweep" IsHitTestVisible="False" Height="160" VerticalAlignment="Top" Opacity="0.05">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="SweepMove" Y="-200" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</Window>
